# Optional API keys. Sources without keys are skipped gracefully.

# Optional: Google Books API key (raises rate limits). Not required.
GOOGLE_BOOKS_API_KEY=

# Optional: Europeana Search API key.
EUROPEANA_API_KEY=

# Optional: Ticketmaster Discovery API key.
TICKETMASTER_API_KEY=

# Optional: YouTube Data API v3 key. Used ONLY for the exploratory annex —
# YouTube data NEVER enters official sub-indices or the composite GACMI.
YOUTUBE_API_KEY=
